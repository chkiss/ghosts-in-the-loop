# The game's name, in one place. Copy to .env to override.
#
# src/brand.ts falls back to these exact values when .env is absent, so a clean
# clone builds and runs without this file. The one place Vite cannot template is
# public/manifest.webmanifest — change that by hand if you rename the game.
VITE_GAME_TITLE=GHOSTS IN THE LOOP
VITE_GAME_SLUG=ghosts-in-the-loop
